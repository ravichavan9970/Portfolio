# =============================================================================
# VERCEL ENVIRONMENT VARIABLES CHEATSHEET & TEMPLATE
# Copy these KEY / VALUE pairs into your Vercel Project Settings > Environment Variables
# =============================================================================

# KEY: RESEND_API_KEY
# VALUE: re_your_actual_resend_api_key_from_resend_com
# Description: Required for /api/contact to send contact emails directly to your Gmail
RESEND_API_KEY=re_your_api_key_here

# KEY: VITE_SITE_URL
# VALUE: https://ravindra-chavan.vercel.app
# Description: Production domain URL for SEO canonical links
VITE_SITE_URL=https://ravindra-chavan.vercel.app

# KEY: VITE_ADMIN_USER
# VALUE: Ravindra_chavan_2002
# Description: Admin username for Availability Status selector
VITE_ADMIN_USER=Ravindra_chavan_2002

# KEY: VITE_ADMIN_PASS
# VALUE: Ravi@7447
# Description: Admin password for Availability Status selector
VITE_ADMIN_PASS=Ravi@7447
